  "cheerLines": [
    { "id": 1, "jp": "ラーネイレ「がんばれ～」", "en": "Larneire cheers, \"Way to go!\"" },
    { "id": 2, "jp": "ロミアス「陰ながら応援しているよ（ニヤリ）」", "en": "Lomias grins, \"Go for it.\"" },
    { "id": 3, "jp": "クミロミ「…大丈夫…だよね？」", "en": "Kumiromi worries, \"Are you...okay..?\"" },
    { "id": 4, "jp": "ルルウィ「あら、思いの他がんばるのね」", "en": "Lulwy sneers, \"You're tougher than I thought, little kitty.\"" },
    { "id": 5, "jp": "ラーネイレ「いけない。このままでは…手遅れになってしまうわ…」", "en": "Larneire cries, \"No...before it is too late...\"" },
    { "id": 6, "jp": "ロミアス「まだまだ、これからだろう（ニヤリ）」", "en": "Lomias grins, \"Tt hasn't even started yet... hasn't it?\"" },
    { "id": 7, "jp": "ルルウィ「休憩しなさい。壊れちゃったら、私の役にたてないじゃない」", "en": "Lulwy warns you, \"Have a rest, kitty. If you are broken, you're no use to me.\"" },
    { "id": 8, "jp": "ルルウィ「何を言っても無駄のようね。好きにするといいわ」", "en": "Lulwy laughs, \"I guess there's no use warning you. Alright. Do as you please, kitty.\"" },
    { "id": 9, "jp": "ヤカテクト「体を壊したら元も子もないんやで？」", "en": "Opatos laughs, \"Muwahahahahahaha!\"" },
    { "id": 12, "jp": "オパートス「フハハハハッフハー」", "en": "Opatos laughs, \"Muwahahahahahaha!\"" },
    { "id": 24, "jp": "エヘカトル「死なにゃいで！死なにゃいって約束して！して！」", "en": "Ehekatl hugs you,\"Don't die! Promise you don't die!\"" }
  ],
